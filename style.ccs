/* Estilos personalizados del proyecto */
body { 
    font-family: 'Inter', sans-serif; 
}

/* Efecto al seleccionar casilla de netbook */
.netbook-checkbox:checked + label {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #1d4ed8;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);
}