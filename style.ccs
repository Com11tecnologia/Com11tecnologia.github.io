 /* Estilos visuales para las casillas de netbook */

/* Ocultar input manteniendo accesibilidad */
.netbook-checkbox {
    position: absolute;
    opacity: 0;
    pointer-events: auto;
}

/* Estado SELECCIONADO / MARCADO (Verde Esmeralda destellante) */
.netbook-checkbox:checked + label {
    background-color: #059669 !important;
    color: #ffffff !important;
    border-color: #047857 !important;
    box-shadow: 0 10px 15px -3px rgba(5, 150, 105, 0.4), 0 4px 6px -4px rgba(5, 150, 105, 0.2) !important;
    transform: translateY(-2px) scale(1.03);
}

.netbook-checkbox:checked + label i {
    color: #ffffff !important;
}

.netbook-checkbox:checked + label .status-text {
    color: #ffffff !important;
}

/* Transición suave */
.netbook-card {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.netbook-card:hover {
    transform: translateY(-2px);
}